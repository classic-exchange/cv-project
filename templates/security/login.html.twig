{% extends 'base.html.twig' %}
{% block title %}
	Log in!
{% endblock %}
{% block body %}
	<div class="container">
		<div class="row justify-content-center">
			<div class="col-md-3">
				<form method="post">
					{% if error %}
						<div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
					{% endif %}
					<div class="mt-3">
						<h3>
							Log into account
						</h3>
					</div>
					<div class="input-group mb-3">
						<div class="form-floating position-relative">
							<input type="email" value="{{ last_username }}" name="_username" id="username" class="form-control pe-5 shadow-none" autocomplete="email" placeholder="email" required>
							<label for="username">Email</label>
							<span class="position-absolute top-50 end-0 translate-middle-y me-3" aria-hidden="true">
								<i class="bi bi-envelope"></i>
							</span>
						</div>
					</div>
					<div class="input-group mb-3">
						<div class="form-floating position-relative" data-controller="password-visibility">
							<input type="password" name="_password" id="password" class="form-control pe-5 shadow-none" autocomplete="current-password" placeholder="password" required data-password-visibility-target="input">
							<label for="password">Password</label>
							<span class="position-absolute top-50 end-0 translate-middle-y me-3">
								<i class="bi bi-eye" data-password-visibility-target="icon" data-action="click->password-visibility#toggle"></i>
							</span>
						</div>
					</div>
					<input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">
					<div class="d-grid mb-3">
						<button class="btn btn-lg btn-primary" type="submit">
							Sign in
						</button>
					</div>
					<div class="text-center text-body-secondary mb-1">
						<small>Continue with:</small>
					</div>
					<div class="d-flex justify-content-center gap-3 mb-3">
						<a href="{{ path('app_login_google') }}" class="btn btn-outline-secondary flex-fill">
							<i class="bi bi-google me-1"></i>
							Google
						</a>
						<a href="{{ path('app_login_github') }}" class="btn btn-outline-secondary flex-fill">
							<i class="bi bi-github me-1"></i>
							Github
						</a>
					</div>
					<div class="text-center">
						<small class="text-body-secondary">
							Don't have an account yet?
							<a href="{{ path('app_register') }}">
								Sign up
							</a>
						</small>
					</div>
				</form>
			</div>
		</div>
	</div>
{% endblock %}
